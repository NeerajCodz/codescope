# GitHub Personal Access Token (Optional)
# Get one at: https://github.com/settings/tokens
# Scopes needed: repo (for private repos), public_repo (for public repos)
NEXT_PUBLIC_GITHUB_TOKEN=

# GitHub OAuth Configuration
# Register your app at: https://github.com/settings/developers
# Set callback URL to: http://localhost:3000/api/auth/github
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# SurrealDB Configuration (Optional — for advanced mode graph persistence)
# Simple mode uses in-browser WASM with IndexedDB (no server needed)
# Advanced mode connects to SurrealDB Cloud using JWT (JWKS-verified)
# Sign up at: https://surrealdb.com/cloud  →  copy your instance URL and token
SURREALDB_URL=https://your-instance.surreal.cloud
SURREALDB_NS=codescope
SURREALDB_DB=analysis
# JWT token obtained from SurrealDB Cloud dashboard (Settings → Access tokens)
# The token is verified via JWKS — no username/password needed
SURREALDB_TOKEN=your_surrealdb_jwt_token_here
NEXT_PUBLIC_SURREALDB_NS=codescope
NEXT_PUBLIC_SURREALDB_DB=analysis
# Expose token to browser only if you use client-side (WASM) mode too
# NEXT_PUBLIC_SURREALDB_TOKEN=your_surrealdb_jwt_token_here
